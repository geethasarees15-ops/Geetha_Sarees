{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "geetha-sarees-media-proxy",
  "account_id": "0ca86b3df45e2ec8ada80c694d2e34a5",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "geetha-sarees-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
