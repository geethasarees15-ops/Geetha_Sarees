# Copy ALL lines below into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Values: copy from your local .env.local — never commit .env.local.

# Supabase (NEW empty project — paste from Dashboard → Settings → API / Database)
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_SERVICE_ROLE=

# Database — pooler URI (port 6543). Then run:
#   npm run db:bootstrap-new
DATABASE_URL=

# Media — default = Supabase Storage until R2 is ready (placeholders OK for now)
NEXT_PUBLIC_S3_BUCKET=placeholder
NEXT_PUBLIC_S3_REGION=auto
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder

# Cloudflare R2 (fill later — when set, new uploads go to R2 / CDN)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# NEXT_PUBLIC_CDN_URL=https://pub-<id>.r2.dev
# NEXT_PUBLIC_S3_BUCKET=<r2-bucket-name>
# S3_ACCESS_KEY_ID=<r2-access-key>
# S3_SECRET_ACCESS_KEY=<r2-secret-key>
# Optional: R2_MEDIA_PROXY_URL=  R2_MEDIA_PROXY_SECRET=

# Stripe (placeholders until Razorpay/Stripe setup)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECERT_KEY=whsec_placeholder

# Deployment — production custom domain
NEXT_PUBLIC_SITE_URL=https://www.sairaghavendratex.com

# Guest order access tokens (required in production — do not rely on fallbacks)
ORDER_ACCESS_SECRET=

# Auth rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — only if you add external cron (Vercel Pro or cron-job.org).
CRON_SECRET=

# Local/docker builds only — omit in Vercel Production once all vars above are set
# SKIP_ENV_VALIDATION=true
